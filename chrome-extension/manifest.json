{
  "manifest_version": 3,
  "name": "ClickUpTasks Clipper",
  "version": "1.14.0",
  "description": "Create or update a ClickUpTasks task from a Gmail email, or review any website (local or live) and add changes to the client's list in one keystroke each.",
  "permissions": ["storage", "sidePanel", "activeTab", "tabs", "tabGroups"],
  "host_permissions": ["https://mail.google.com/*", "https://clickuptasks.vercel.app/*"],
  "action": {},
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"]
    }
  ],
  "options_page": "options.html"
}
